{
  "name": "@psomby/google-merchant-feed",
  "version": "0.1.6",
  "description": "A simple library to generate Google Merchant XML Feed",
  "author": "Douglas Gusson",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "keywords": [
    "google",
    "merchant",
    "feed",
    "xml",
    "product",
    "products",
    "shopping"
  ],
  "homepage": "https://github.com/psomby/google-merchant-feed/",
  "repository": {
    "type": "git",
    "url": "https://github.com/psomby/google-merchant-feed/"
  },
  "bugs": {
    "url": "https://github.com/psomby/google-merchant-feed/issues"
  },
  "files": [
    "src",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc",
    "watch": "tsc --watch",
    "prettier": "prettier --write .",
    "lint": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run clean",
    "clean": "rm -rf ./dist"
  },
  "dependencies": {
    "xmlbuilder2": "^3.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "prettier": "^3.4.2",
    "tslib": "^2.8.1",
    "typescript": "^5.2.2"
  }
}
